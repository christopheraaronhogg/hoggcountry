---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Account — Hogg Country';
const description = 'Sign in with Google to sync your profile and trail data across devices.';
const apiBase = (import.meta.env.PUBLIC_API_BASE_URL || 'https://hoggcountry.on-forge.com/api/v1').replace(/\/+$/, '');
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <span class="chapter font-chapter">Account</span>
    <h1 class="font-display">Sign In</h1>
    <p>Use Google for a fast login. We keep your trail model local-first and sync in the background.</p>
  </section>

  <div class="container auth-wrap">
    <div class="auth-card">
      <button id="google-login" type="button" class="google-button">Continue with Google</button>
      <a id="login-continue" class="continue-link" href="/trail/" hidden>Continue to Trail Hub</a>
      <button id="logout-button" type="button" class="logout-button" hidden>Log Out</button>
      <p id="login-user" class="user" hidden></p>
      <p id="login-status" class="status" aria-live="polite"></p>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ apiBase }}>
  (() => {
    const API_BASE = apiBase;
    const AUTH_KEY = 'hcApiAuth.v1';
    const REDIRECT_KEY = 'hcLoginRedirect.v1';

    const googleButton = document.getElementById('google-login');
    const continueLink = document.getElementById('login-continue');
    const logoutButton = document.getElementById('logout-button');
    const status = document.getElementById('login-status');
    const userEl = document.getElementById('login-user');

    if (
      !(googleButton instanceof HTMLButtonElement) ||
      !(continueLink instanceof HTMLAnchorElement) ||
      !(logoutButton instanceof HTMLButtonElement) ||
      !(status instanceof HTMLElement) ||
      !(userEl instanceof HTMLElement)
    ) return;

    function parseJson(raw) {
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    function readAuth() {
      const data = parseJson(localStorage.getItem(AUTH_KEY));
      if (!data || typeof data !== 'object' || typeof data.token !== 'string' || !data.token) return null;
      return data;
    }

    function writeAuth(payload) {
      localStorage.setItem(AUTH_KEY, JSON.stringify({
        token: payload.token,
        provider: payload.provider || 'google',
        user: payload.user || null,
        updatedAt: new Date().toISOString(),
      }));
    }

    function clearAuth() {
      localStorage.removeItem(AUTH_KEY);
    }

    function normalizeRedirect(value) {
      if (typeof value !== 'string') return '';
      if (!value.startsWith('/')) return '';
      if (value.startsWith('//')) return '';
      return value;
    }

    function setStatus(message, type = 'info') {
      status.textContent = message;
      status.dataset.type = type;
    }

    function setLoggedOut() {
      googleButton.hidden = false;
      googleButton.disabled = false;
      continueLink.hidden = true;
      logoutButton.hidden = true;
      userEl.hidden = true;
      userEl.textContent = '';
    }

    function setLoggedIn(user, redirectTo) {
      googleButton.hidden = true;
      continueLink.hidden = false;
      continueLink.href = redirectTo;
      logoutButton.hidden = false;
      userEl.hidden = false;
      userEl.textContent = `Signed in as ${user.name || user.email}`;
    }

    async function fetchMe(token) {
      const response = await fetch(`${API_BASE}/auth/me`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (!response.ok) return null;
      const payload = await response.json().catch(() => null);
      return payload?.data || null;
    }

    const searchParams = new URLSearchParams(window.location.search);
    const queryRedirect = normalizeRedirect(searchParams.get('redirect') || '');
    const storedRedirect = normalizeRedirect(sessionStorage.getItem(REDIRECT_KEY) || '');
    const redirectTo = queryRedirect || storedRedirect || '/trail/';
    if (queryRedirect) sessionStorage.setItem(REDIRECT_KEY, queryRedirect);

    const hashParams = new URLSearchParams(window.location.hash.startsWith('#') ? window.location.hash.slice(1) : '');
    const tokenFromHash = hashParams.get('token');
    const providerFromHash = hashParams.get('provider') || 'google';
    const returnedFromProvider = Boolean(tokenFromHash);

    if (tokenFromHash) {
      writeAuth({ token: tokenFromHash, provider: providerFromHash });
      history.replaceState({}, document.title, window.location.pathname + window.location.search);
    }

    async function hydrate() {
      const auth = readAuth();
      if (!auth) {
        setLoggedOut();
        setStatus('Sign in to sync your profile across devices.', 'info');
        return;
      }

      setStatus('Verifying session...', 'info');
      const me = await fetchMe(auth.token);
      if (!me) {
        clearAuth();
        setLoggedOut();
        setStatus('Your session expired. Please sign in again.', 'error');
        return;
      }

      writeAuth({ token: auth.token, provider: auth.provider, user: me });
      setLoggedIn(me, redirectTo);

      if (returnedFromProvider) {
        setStatus('Signed in with Google. Redirecting...', 'success');
        setTimeout(() => {
          window.location.assign(redirectTo);
        }, 500);
      } else {
        setStatus('You are signed in.', 'success');
      }
    }

    googleButton.addEventListener('click', () => {
      googleButton.disabled = true;
      setStatus('Redirecting to Google...', 'info');
      sessionStorage.setItem(REDIRECT_KEY, redirectTo);
      const callbackUrl = new URL('/login', window.location.origin);
      if (queryRedirect) {
        callbackUrl.searchParams.set('redirect', queryRedirect);
      }
      const oauthUrl = new URL(`${API_BASE}/auth/google/redirect`);
      oauthUrl.searchParams.set('callback', callbackUrl.toString());
      window.location.assign(oauthUrl.toString());
    });

    logoutButton.addEventListener('click', async () => {
      const auth = readAuth();
      if (!auth) {
        setLoggedOut();
        return;
      }

      logoutButton.disabled = true;
      setStatus('Signing out...', 'info');
      try {
        await fetch(`${API_BASE}/auth/logout`, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${auth.token}`,
          },
        });
      } catch {
        // Logout token revocation can fail silently; local removal still signs user out in UI.
      }

      clearAuth();
      logoutButton.disabled = false;
      setLoggedOut();
      setStatus('Signed out.', 'success');
    });

    hydrate();
  })();
</script>

<style>
  .auth-wrap {
    max-width: 560px;
    padding: 0 1rem 4rem;
  }

  .auth-card {
    display: grid;
    gap: 0.9rem;
    background: var(--card, #fff);
    border: 1px solid var(--border, #e6e1d4);
    border-radius: 12px;
    padding: 1.1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .google-button,
  .continue-link,
  .logout-button {
    border-radius: 9px;
    padding: 0.72rem 0.9rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .google-button {
    border: 1px solid var(--border, #d8d2c4);
    background: #fff;
    color: #1f2937;
    cursor: pointer;
  }

  .google-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .continue-link {
    border: 0;
    color: #fff;
    background: var(--pine, #4d594a);
    text-decoration: none;
  }

  .logout-button {
    border: 1px solid var(--border, #d8d2c4);
    background: #fff;
    color: #1f2937;
    cursor: pointer;
  }

  .user {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted, #5c665a);
  }

  .status {
    margin: 0;
    min-height: 1.1rem;
    font-size: 0.86rem;
    color: var(--muted, #5c665a);
  }

  .status[data-type='error'] {
    color: #b91c1c;
  }

  .status[data-type='success'] {
    color: #166534;
  }
</style>
