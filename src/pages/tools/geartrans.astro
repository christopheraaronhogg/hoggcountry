---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "Gear Transition Tracker — Trail Tools — Hogg Country";
const description = "Plan seasonal and terrain-based gear swaps for the Appalachian Trail.";
---

<BaseLayout title={title} description={description}>
  <div class="container tools-container">
    <ToolPage client:load toolId="geartrans" title="Gear Transition Tracker" />
  </div>
</BaseLayout>

<style>
  .tools-container {
    padding: 1rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>

