---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Test Page" description="Testing deployment">
  <div class="container" style="padding: 4rem 1rem; text-align: center;">
    <h1 style="font-size: 3rem; color: red;">TEST PAGE WORKS!</h1>
    <p style="font-size: 1.5rem; margin-top: 1rem;">
      Deployed: {new Date().toISOString()}
    </p>
    <p style="margin-top: 2rem;">
      If you see this, deployment is working.
    </p>
  </div>
</BaseLayout>
