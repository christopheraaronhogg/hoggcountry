# Production build config for the Hogg Country mobile app.
# Vite loads this automatically for `vite build` (production mode), so EVERY
# shipped/sideloaded build — not just the Play release script — is Gemma-only.
#
# The deterministic template answer lane was removed. Keep this explicit so a
# future environment edit cannot accidentally reintroduce non-model Scout prose.
# Only VITE_-prefixed (public, non-secret) vars belong here.
VITE_SCOUT_MODEL_POLICY=gemma4-only
