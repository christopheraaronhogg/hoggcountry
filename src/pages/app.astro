---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'HoggCountry App - iOS + Android';
const description = 'Get the HoggCountry trail app for live map tracking, local-first planning, and one-tap video handoff from the trail.';

const appStoreUrl = String(import.meta.env.PUBLIC_APP_STORE_URL || '').trim();
const playStoreUrl = String(import.meta.env.PUBLIC_PLAY_STORE_URL || '').trim();
const waitlistUrl = String(import.meta.env.PUBLIC_APP_WAITLIST_URL || '/login?redirect=%2Ftrail').trim();

const hasAppStore = appStoreUrl !== '';
const hasPlayStore = playStoreUrl !== '';
---

<BaseLayout title={title} description={description}>
  <section class="app-hero">
    <div class="app-hero__noise" aria-hidden="true"></div>
    <div class="container app-hero__content">
      <p class="app-hero__kicker font-chapter">Mobile Launch</p>
      <h1 class="font-display">HoggCountry is going native.</h1>
      <p class="app-hero__copy">
        Built for hikers on phone-first workflows: prep locally, run live on trail, and sync safely when signal returns.
      </p>

      <div class="store-grid" aria-label="Download options">
        <a
          class={`store-btn ${!hasAppStore ? 'is-disabled' : ''}`}
          href={hasAppStore ? appStoreUrl : '#'}
          target={hasAppStore ? '_blank' : undefined}
          rel={hasAppStore ? 'noopener noreferrer' : undefined}
          aria-disabled={!hasAppStore}
        >
          <span class="store-btn__eyebrow">Download on the</span>
          <strong>App Store</strong>
        </a>
        <a
          class={`store-btn ${!hasPlayStore ? 'is-disabled' : ''}`}
          href={hasPlayStore ? playStoreUrl : '#'}
          target={hasPlayStore ? '_blank' : undefined}
          rel={hasPlayStore ? 'noopener noreferrer' : undefined}
          aria-disabled={!hasPlayStore}
        >
          <span class="store-btn__eyebrow">Get it on</span>
          <strong>Google Play</strong>
        </a>
      </div>

      {(!hasAppStore || !hasPlayStore) && (
        <p class="launch-note">
          Store listings are being finalized. Join early access for dad-first testing on the AT.
        </p>
      )}

      <div class="hero-actions">
        <a class="btn btn-primary" href={waitlistUrl}>Join Early Access</a>
        <a class="btn" href="/trail">Open Trail Hub</a>
      </div>
    </div>
  </section>

  <section class="container app-proof">
    <article class="proof-card">
      <h2 class="font-display">One shell. Three trail modes.</h2>
      <div class="proof-grid">
        <div class="proof-pill">
          <p class="proof-pill__label">Prep</p>
          <p>Pack, budget, weather, route checks.</p>
        </div>
        <div class="proof-pill">
          <p class="proof-pill__label">Live</p>
          <p>Map overlay, water/food decisions, quick notes.</p>
        </div>
        <div class="proof-pill">
          <p class="proof-pill__label">Post</p>
          <p>Video handoff + summary sync back to account.</p>
        </div>
      </div>
    </article>

    <article class="proof-card">
      <h2 class="font-display">Built for no-service reality.</h2>
      <ul class="proof-list">
        <li>Local-first character + gear model.</li>
        <li>Background sync when connection returns.</li>
        <li>Private-by-default map sharing controls.</li>
        <li>Garmin feed + phone GPS fallback.</li>
      </ul>
    </article>
  </section>
</BaseLayout>

<style>
  .app-hero {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid rgba(77, 89, 74, 0.22);
    background:
      radial-gradient(circle at 10% 18%, rgba(217, 119, 6, 0.22), transparent 38%),
      radial-gradient(circle at 90% 12%, rgba(166, 181, 137, 0.28), transparent 42%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.9), rgba(245, 242, 232, 0.95));
  }

  .app-hero__noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    background-image: radial-gradient(rgba(77, 89, 74, 0.17) 0.6px, transparent 0.6px);
    background-size: 8px 8px;
    mix-blend-mode: multiply;
  }

  .app-hero__content {
    position: relative;
    z-index: 2;
    padding-top: 3.2rem;
    padding-bottom: 2.6rem;
    text-align: center;
    max-width: 900px;
  }

  .app-hero__kicker {
    margin: 0;
    font-size: 0.88rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .app-hero h1 {
    margin: 0.45rem 0 0;
    font-size: clamp(2rem, 8vw, 4.2rem);
    line-height: 0.98;
  }

  .app-hero__copy {
    margin: 0.9rem auto 0;
    max-width: 30rem;
    color: var(--muted);
    font-size: clamp(1rem, 2.7vw, 1.2rem);
    line-height: 1.45;
  }

  .store-grid {
    margin: 1.2rem auto 0;
    display: grid;
    gap: 0.62rem;
    max-width: 520px;
    grid-template-columns: 1fr;
  }

  .store-btn {
    text-decoration: none;
    border-radius: 16px;
    border: 1px solid rgba(31, 41, 55, 0.18);
    background: linear-gradient(165deg, #fffef8, #f8f2e6);
    color: #1f2937;
    box-shadow: 0 12px 28px rgba(31, 41, 55, 0.14);
    padding: 0.84rem 1rem;
    display: grid;
    gap: 0.12rem;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 32px rgba(31, 41, 55, 0.2);
  }

  .store-btn strong {
    font-family: Oswald, Impact, sans-serif;
    letter-spacing: 0.03em;
    font-size: 1.16rem;
  }

  .store-btn__eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #495566;
  }

  .store-btn.is-disabled {
    opacity: 0.56;
    pointer-events: none;
    box-shadow: none;
  }

  .launch-note {
    margin: 0.78rem auto 0;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .hero-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.56rem;
  }

  .app-proof {
    padding-top: 1.1rem;
    padding-bottom: 2.8rem;
    display: grid;
    gap: 0.78rem;
  }

  .proof-card {
    border-radius: 18px;
    border: 1px solid rgba(77, 89, 74, 0.2);
    background: rgba(255, 255, 255, 0.78);
    padding: 1rem;
  }

  .proof-card h2 {
    margin: 0;
    font-size: clamp(1.32rem, 4vw, 2rem);
  }

  .proof-grid {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.5rem;
  }

  .proof-pill {
    border-radius: 12px;
    border: 1px solid rgba(77, 89, 74, 0.2);
    background: rgba(245, 242, 232, 0.82);
    padding: 0.75rem;
  }

  .proof-pill p {
    margin: 0;
    color: #2f3e4f;
    line-height: 1.35;
  }

  .proof-pill__label {
    font-family: Oswald, Impact, sans-serif;
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--pine);
    text-transform: uppercase;
  }

  .proof-list {
    margin: 0.7rem 0 0;
    padding: 0 0 0 1rem;
    color: #334154;
    display: grid;
    gap: 0.46rem;
  }

  .proof-list li {
    line-height: 1.4;
  }

  @media (min-width: 760px) {
    .app-hero__content {
      padding-top: 4.4rem;
      padding-bottom: 3.2rem;
    }

    .store-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 660px;
    }

    .app-proof {
      grid-template-columns: 1.35fr 1fr;
      align-items: start;
    }

    .proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
