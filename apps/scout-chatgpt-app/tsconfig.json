{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
