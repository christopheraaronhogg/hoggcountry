---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "Budget Calculator — Trail Tools — Hogg Country";
const description = "Track and project on-trail spending for an AT thru-hike.";
---

<BaseLayout title={title} description={description}>
  <div class="container tools-container">
    <ToolPage client:load toolId="budget" title="Budget Calculator" />
  </div>
</BaseLayout>

<style>
  .tools-container {
    padding: 1rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>

