{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "name",
      "owner",
      "source_url",
      "source_type",
      "access_method",
      "license_status",
      "allowed_use",
      "attribution_required",
      "data_categories",
      "update_cadence",
      "confidence",
      "last_checked",
      "notes"
    ],
    "properties": {
      "source_id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
      "name": { "type": "string", "minLength": 2 },
      "owner": { "type": "string", "minLength": 2 },
      "source_url": { "type": "string", "minLength": 4 },
      "source_type": { "type": "string", "minLength": 2 },
      "access_method": { "type": "string", "minLength": 2 },
      "license_status": {
        "type": "string",
        "enum": [
          "public_domain",
          "open_license_attribution",
          "open_license_share_alike",
          "api_access_allowed",
          "permission_required",
          "unknown_review_required",
          "blocked"
        ]
      },
      "allowed_use": { "type": "string", "minLength": 2 },
      "attribution_required": { "type": "string", "minLength": 2 },
      "data_categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "update_cadence": { "type": "string", "minLength": 2 },
      "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
      "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "notes": { "type": "string" }
    }
  }
}
