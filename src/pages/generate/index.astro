---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShelvedFeature from '../../components/ShelvedFeature.astro';
import { WORKSPACE_URL } from '../../lib/config';
---

<BaseLayout title="Guide Generator Shelved | Hogg Country" description="The old guide generator has been replaced by the personal field manual workspace.">
  <ShelvedFeature
    feature="ROUTE_GENERATE"
    heading="The old generator is shelved."
    body="Guide generation now belongs in the personal field manual workspace. That is where setup, search, notes, and saved documents now live together."
    primary={{ href: WORKSPACE_URL, label: 'Open workspace' }}
    secondary={{ href: '/guide/manual-builder/', label: 'Open field manual preview' }}
  />
</BaseLayout>
