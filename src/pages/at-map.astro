---
import BaseLayout from "../layouts/BaseLayout.astro";
import AtMapIsland from "../components/AtMap.svelte";
---

<BaseLayout
  title="Appalachian Trail Map"
  description="Interactive map of the Appalachian Trail (OSM-derived)."
>
  <AtMapIsland client:only="svelte" />
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }

  /* /at-map is the full-screen hub; navigation is provided via the HUD */
  :global(#site-header),
  :global(footer),
  :global(#version-stamp) {
    display: none;
  }

  :global(main#main-content) {
    padding: 0;
  }
</style>
