    "src/**/*",
    "netlify/functions/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "svelte.config.js"
  ],
  "exclude": ["dist", "trailhogg", "audit-reports", "private", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true
  }
}
