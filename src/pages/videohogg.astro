  .vh-remotion-track-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    border-radius: 10px;
    border: 1px solid rgba(15, 23, 42, 0.16);
    background: linear-gradient(180deg, #172033, #111827);
    scrollbar-width: thin;
  }

  .vh-remotion-track {
    position: relative;
