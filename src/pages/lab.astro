---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  allFlags,
  type Flag,
  type FlagStatus,
  type FeatureKey,
} from '../lib/features';

const STATUS_ORDER: FlagStatus[] = [
  'live',
  'experimental',
  'merged',
  'deferred',
  'archived',
];

const STATUS_LABELS: Record<FlagStatus, string> = {
  live: 'Live',
  experimental: 'Experimental',
  merged: 'Merged',
  deferred: 'Deferred',
  archived: 'Archived',
};

const STATUS_DESCRIPTIONS: Record<FlagStatus, string> = {
  live: 'Shipping in v1.',
  experimental: 'Unfinished. May return when it supports a live surface.',
  merged: 'Logic absorbed into a live surface. UI retired.',
  deferred: 'Intentionally off for v1. On the post-v1 roadmap.',
  archived: 'Off. No current plan to return.',
};

type Grouped = Record<FlagStatus, Array<[FeatureKey, Flag]>>;
const grouped: Grouped = {
  live: [],
  experimental: [],
  merged: [],
  deferred: [],
  archived: [],
};

for (const [key, flag] of allFlags()) {
  grouped[flag.status].push([key, flag]);
}

const totalCount = allFlags().length;
---

<BaseLayout title="Lab | Hogg Country" description="Developer-facing index of flagged-off work in the Hogg Country repo.">
  <article class="lab">
    <header class="lab-header">
      <p class="lab-kicker">Dev-only</p>
      <h1>Lab</h1>
      <p class="lab-sub">
        Every feature in the repo, grouped by status. Not linked from public nav.
        This is the shelf where work lives when it is not yet ready - or no longer
        the product. See <code>PRODUCT_BRIEF.md</code> for the v1 scope.
      </p>
      <p class="lab-meta">{totalCount} flags tracked</p>
    </header>

    {STATUS_ORDER.map((status) => {
      const items = grouped[status];
      if (items.length === 0) return null;
      return (
        <section class={`status-group status-${status}`}>
          <div class="status-heading">
            <h2>
              <span class={`badge badge-${status}`}>{STATUS_LABELS[status]}</span>
              <span class="status-count">{items.length}</span>
            </h2>
            <p class="status-desc">{STATUS_DESCRIPTIONS[status]}</p>
          </div>
          <ul class="flag-list">
            {items.map(([key, flag]) => (
              <li class="flag-item">
                <code class="flag-key">{key}</code>
                <p class="flag-reason">{flag.reason}</p>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </article>
</BaseLayout>

<style>
  .lab {
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .lab-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border, #e2e0d8);
  }

  .lab-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted, #8a8578);
    margin: 0 0 0.25rem;
    font-weight: 600;
  }

  .lab h1 {
    font-size: 2.5rem;
    margin: 0 0 0.75rem;
    line-height: 1;
  }

  .lab-sub {
    font-size: 1rem;
    color: var(--color-muted, #55504a);
    max-width: 42rem;
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .lab-sub code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: var(--color-surface-alt, #f1efe7);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .lab-meta {
    font-size: 0.8rem;
    color: var(--color-muted, #8a8578);
    margin: 0;
  }

  .status-group {
    margin-bottom: 2.75rem;
  }

  .status-heading {
    margin-bottom: 1rem;
  }

  .status-heading h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }

  .status-count {
    font-size: 0.8rem;
    color: var(--color-muted, #8a8578);
    font-weight: 400;
  }

  .status-desc {
    font-size: 0.85rem;
    color: var(--color-muted, #8a8578);
    margin: 0;
    font-style: italic;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25em 0.6em;
    border-radius: 3px;
    border: 1px solid currentColor;
  }

  .badge-live { color: #2d5a3d; background: #e4f0e6; }
  .badge-experimental { color: #6b4e1a; background: #f5ecd4; }
  .badge-merged { color: #3a4a6b; background: #e2e8f3; }
  .badge-deferred { color: #4a4a4a; background: #ededed; }
  .badge-archived { color: #6b3a3a; background: #f1e0e0; }

  .flag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .flag-item {
    padding: 0.85rem 1rem;
    background: var(--color-surface, #fafaf6);
    border: 1px solid var(--color-border, #e2e0d8);
    border-radius: 4px;
  }

  .flag-key {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink, #2a2822);
    margin-bottom: 0.35rem;
  }

  .flag-reason {
    font-size: 0.875rem;
    color: var(--color-muted, #55504a);
    margin: 0;
    line-height: 1.5;
  }
</style>
