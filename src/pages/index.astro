---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrailUpdatesFeed from '../components/TrailUpdatesFeed.astro';
import YouTubeThumbnail from '../components/YouTubeThumbnail.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { facts, getMeta } from '../data/trailFacts';
import { WORKSPACE_URL, YT_UPLOADS_FEED_URL } from '../lib/config';
import { isEnabled } from '../lib/features';
import { fetchYouTubeRSS } from '../lib/youtube';

const showVideos = isEnabled('YOUTUBE_RSS');
const videos = showVideos ? (await fetchYouTubeRSS(YT_UPLOADS_FEED_URL)).slice(0, 3) : [];
const meta = getMeta();

function formatDate(value: string) {
  if (!value) return '';
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return '';
  return parsed.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function clipText(value: string, max = 130) {
  const cleaned = String(value || '').replace(/\s+/g, ' ').trim();
  if (!cleaned) return '';
  if (cleaned.length <= max) return cleaned;
  return `${cleaned.slice(0, max).trimEnd()}...`;
}

function youtubeLabel(video: (typeof videos)[number]) {
  return video.kind === 'short' ? 'YouTube Short' : 'Video Dispatch';
}

---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy card">
        <p class="eyebrow">Appalachian Trail Operating Manual</p>
        <h1>Dad&apos;s field guide stays public. Your manual gets personal.</h1>
        <p class="lede">
          Hogg Country now does two jobs clearly: keep Jimmy Hogg&apos;s complete Appalachian Trail field guide
          free on the public site, and give hikers a workspace to turn that guidance into their own local-first field manual.
        </p>

        <div class="hero-actions">
          <a href="/guide/" class="primary-link">Read Dad&apos;s Field Guide</a>
          <a href={WORKSPACE_URL} class="secondary-link">Open Workspace</a>
        </div>

        <div class="hero-stats">
          <div>
            <strong>{facts.trail.total_miles.value}</strong>
            <span>Trail miles in the audited fact base</span>
          </div>
          <div>
            <strong>{facts.trail.shelter_count.value}+</strong>
            <span>Shelters tracked in the current corpus</span>
          </div>
          <div>
            <strong>{meta.last_verified}</strong>
            <span>Last trail-facts verification</span>
          </div>
        </div>
      </div>

      <aside class="hero-side card">
        <p class="eyebrow">What stays core</p>
        <ul class="focus-list">
          <li>Dad&apos;s full NOBO field guide remains the public anchor.</li>
          <li>The personal workspace is where hikers build and carry their own manual.</li>
          <li>Video dispatches stay live as a secondary public surface.</li>
          <li>Trail facts remain audited and source-backed instead of turning into rumor soup.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="container">
    <TrailUpdatesFeed limit={3} compact />
  </section>

  <section class="container pillars">
    <article class="card pillar">
      <p class="eyebrow">Public Staple</p>
      <h2>Dad&apos;s Field Guide</h2>
      <p>The complete public reference stays in the codebase and stays free. It is still the backbone of Hogg Country.</p>
      <a href="/guide/">Open the guide</a>
    </article>

    <article class="card pillar">
      <p class="eyebrow">Personal Layer</p>
      <h2>Manual Workspace</h2>
      <p>Use the workspace to turn the guide into your own manual: setup, Today, Plan, Docs, Search, and exportable notes.</p>
      <a href={WORKSPACE_URL}>Go to workspace</a>
    </article>

    <article class="card pillar">
      <p class="eyebrow">Trail Voice</p>
      <h2>Video Dispatches</h2>
      <p>Jimmy&apos;s videos are still part of the product. They just stop being the front door and become the living voice beside the guide.</p>
      <a href="/videos/">Watch dispatches</a>
    </article>
  </section>

  <section class="container guide-band card">
    <div>
      <p class="eyebrow">Why this split works</p>
      <h2>One public source of wisdom, one private source of truth.</h2>
      <p>
        The public site keeps the authored voice and the complete trail guide intact. The workspace keeps your personal copy local,
        searchable, and ready offline. That means the guide does not get diluted, and your own manual does not have to live inside a generic chat box.
      </p>
    </div>
    <div class="guide-band-actions">
      <a href="/guide/" class="primary-link">Start with the guide</a>
      <a href="/guide/manual-builder/" class="secondary-link">See the current manual builder</a>
    </div>
  </section>

  {showVideos && (
    <section class="container video-section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Latest From Dad</p>
          <h2>Video dispatches and Shorts stay in the mix.</h2>
        </div>
        <a href="/videos/" class="section-link">See all videos and Shorts</a>
      </div>

      <div class="video-grid">
        {videos.map((video) => (
          <article class="card video-card">
            <a href={video.link} class="video-media" target="_blank" rel="noopener noreferrer">
              <YouTubeThumbnail id={video.id} alt={video.title} loading="lazy" provided={video.thumbnail} />
            </a>
            <div class="video-copy">
              <p class="video-meta">{youtubeLabel(video)} • {formatDate(video.published) || 'Recent upload'}</p>
              <h3>{video.title}</h3>
              {clipText(video.description) && <p>{clipText(video.description)}</p>}
              <a href={video.link} target="_blank" rel="noopener noreferrer">
                {video.kind === 'short' ? 'Watch Short on YouTube' : 'Watch on YouTube'}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .card {
    border: 1px solid rgba(48, 65, 54, 0.12);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 22px 50px rgba(60, 44, 25, 0.08);
  }

  .home-hero {
    padding: 2rem 0 1rem;
    background:
      radial-gradient(circle at top left, rgba(166, 181, 137, 0.16), transparent 30%),
      radial-gradient(circle at top right, rgba(240, 224, 0, 0.16), transparent 24%),
      linear-gradient(180deg, #f6f1e7 0%, #f5efe2 100%);
  }

  .hero-grid {
    display: grid;
    gap: 1rem;
  }

  .hero-copy,
  .hero-side {
    padding: 1.35rem;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--ink);
    line-height: 1.02;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    max-width: 12ch;
  }

  .lede,
  .pillar p,
  .guide-band p,
  .video-copy p {
    color: var(--muted);
    line-height: 1.7;
  }

  .hero-actions,
  .guide-band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }

  .primary-link,
  .secondary-link,
  .section-link,
  .pillar a,
  .video-copy a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    width: fit-content;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0.03em;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .primary-link {
    background: linear-gradient(160deg, #304136, #495d4d);
    color: #fff7ea;
  }

  .secondary-link,
  .section-link,
  .pillar a,
  .video-copy a {
    border: 1px solid rgba(48, 65, 54, 0.12);
    background: rgba(255, 255, 255, 0.72);
    color: var(--pine);
  }

  .primary-link:hover,
  .secondary-link:hover,
  .section-link:hover,
  .pillar a:hover,
  .video-copy a:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .hero-stats div {
    display: grid;
    gap: 0.25rem;
    padding: 0.95rem;
    border-radius: 18px;
    background: rgba(245, 242, 232, 0.84);
  }

  .hero-stats strong {
    font-size: 1.2rem;
    color: var(--pine);
  }

  .hero-stats span {
    color: var(--muted);
    line-height: 1.55;
  }

  .focus-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--pine);
    line-height: 1.7;
  }

  .focus-list li + li {
    margin-top: 0.7rem;
  }

  .pillars {
    display: grid;
    gap: 1rem;
    padding: 1rem 0;
  }

  .pillar {
    padding: 1.25rem;
  }

  .guide-band {
    display: grid;
    gap: 1rem;
    padding: 1.35rem;
    margin-top: 0.5rem;
  }

  .video-section {
    padding: 1.5rem 0 2.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .video-grid {
    display: grid;
    gap: 1rem;
  }

  .video-card {
    overflow: hidden;
  }

  .video-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: #17201a;
  }

  .video-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-copy {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .video-meta {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: var(--pine);
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
      align-items: stretch;
    }

    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .guide-band {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .video-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
