{
  "name": "@hoggcountry/scout-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SCOUT_WORKSPACE_DATA_DIR=$(node -p \"require('path').resolve(require('path').dirname(process.env.npm_package_json), '../../backend/storage/app/scout-workspaces')\") vite dev --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "build:node": "SCOUT_WEB_ADAPTER=node svelte-kit sync && vite build",
    "preview": "SCOUT_WORKSPACE_DATA_DIR=$(node -p \"require('path').resolve(require('path').dirname(process.env.npm_package_json), '../../backend/storage/app/scout-workspaces')\") vite preview --host",
    "check": "svelte-kit sync",
    "start:node": "SCOUT_WORKSPACE_DATA_DIR=$(node -p \"require('path').resolve(require('path').dirname(process.env.npm_package_json), '../../backend/storage/app/scout-workspaces')\") HOST=${HOST:-127.0.0.1} PORT=${PORT:-3000} node build",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/lib/module_bindings --module-path spacetimedb"
  },
  "dependencies": {
    "@hoggcountry/brand": "file:../../packages/brand",
    "@hoggcountry/corpus": "file:../../packages/corpus",
    "@hoggcountry/manual-core": "file:../../packages/manual-core",
    "@hoggcountry/scout-sources": "file:../../packages/scout-sources",
    "@hoggcountry/trail-data": "file:../../packages/trail-data",
    "@mariozechner/pi-agent-core": "^0.67.68",
    "@mariozechner/pi-ai": "^0.67.68",
    "leaflet": "^1.9.4",
    "marked": "^17.0.1",
    "spacetimedb": "^2.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.55.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
