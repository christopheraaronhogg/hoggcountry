---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "Resupply Calculator — Trail Tools";
const description = "Plan your trail town resupply stops. Find grocery stores, hostels, and outfitters.";
---

<BaseLayout title={title} description={description}>
  <div class="container tool-container">
    <ToolPage client:load toolId="resupply" toolName="Resupply Calculator" />
  </div>
</BaseLayout>

<style>
  .tool-container {
    padding: 2rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>
