    justify-items: center;
    gap: 0.08rem;
    color: #64748b;
    font-size: 0.66rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .vh-remotion-ruler-tick::before {
    content: '';
    width: 1px;
    height: 7px;
    background: rgba(100, 116, 139, 0.38);
    border-radius: 999px;
