# Hogg Country mobile pilot - copy to .env to override build-time config.
# Vite only exposes vars prefixed with VITE_ to the app.

# Where Scout fetches the trail-ahead field pack.
# Leave unset to use the baked default in src/lib/trailState.svelte.ts
# (currently the Forge validation host). Point at production for Dad's phone:
# VITE_SCOUT_FIELD_PACK_URL=https://hoggcountry.com/scout/field-pack

# Trail Pulse live sync (optional; leave blank to disable).
# PUBLIC_SPACETIMEDB_HOST=
# PUBLIC_SPACETIMEDB_DB_NAME=
