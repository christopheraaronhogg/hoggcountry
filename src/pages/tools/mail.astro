---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "Mail Drop Planner — Trail Tools";
const description = "Plan and track mail drop resupply packages along the Appalachian Trail.";
---

<BaseLayout title={title} description={description}>
  <div class="container tool-container">
    <ToolPage client:load toolId="mail" toolName="Mail Drop Planner" />
  </div>
</BaseLayout>

<style>
  .tool-container {
    padding: 2rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>
