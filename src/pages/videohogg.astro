      in_progress: {
        label: 'In Progress',
        message: 'Active editing is underway right now.',
      },
      packaging: {
        label: 'Packaging',
        message: 'Final files and metadata are being packaged for delivery.',
      },
      delivered: {
        label: 'Delivered',
        message: 'Final package is ready with title/description options.',
