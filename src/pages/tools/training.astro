---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "Training Planner — Trail Tools — Hogg Country";
const description = "Build a training plan leading up to an AT thru-hike.";
---

<BaseLayout title={title} description={description}>
  <div class="container tools-container">
    <ToolPage client:load toolId="training" title="Training Planner" />
  </div>
</BaseLayout>

<style>
  .tools-container {
    padding: 1rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>

