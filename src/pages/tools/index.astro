---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolsDashboard from '../../components/tools/ToolsDashboard.svelte';

const title = "Trail Tools — Hogg Country";
const description = "Interactive tools for AT thru-hiking: milestone planner, weather, budgeting, and more.";
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <span class="chapter font-chapter">AT 2026</span>
    <h1 class="font-display">Trail Tools</h1>
    <p>Interactive planning tools for the Appalachian Trail</p>
  </section>

  <div class="container tools-container">
    <script is:inline>
      // Back-compat: redirect old hash navigation (/tools#water) to routed pages (/tools/water/)
      const hash = window.location.hash?.slice(1);
      const hashMap = {
        milestone: 'milestone',
        weather: 'weather',
        pack: 'pack',
        resupply: 'resupply',
        water: 'water',
        budget: 'budget',
        mail: 'mail',
        power: 'power',
        food: 'food',
        geartrans: 'geartrans',
        training: 'training',
        shelter: 'shelter',
        layers: 'layers',
        emergency: 'emergency',
        // Old id → new route
        gearbudget: 'gear',
      };
      if (hash && hashMap[hash]) window.location.replace(`/tools/${hashMap[hash]}/`);
    </script>

    <ToolsDashboard client:load />
  </div>
</BaseLayout>

<style>
  .tools-container {
    padding-bottom: 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>
