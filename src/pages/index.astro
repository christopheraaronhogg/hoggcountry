---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProtoF from '../components/prototypes/ProtoF_Ranger.svelte';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { YT_CHANNEL_FEED_URL } from '../lib/config';
import { fetchYouTubeRSS } from '../lib/youtube';

// Build-time fallback only; ProtoF refreshes from Laravel API at runtime.
const videos = await fetchYouTubeRSS(YT_CHANNEL_FEED_URL);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <ProtoF client:visible videos={videos} />
</BaseLayout>
