---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/tools/ToolPage.svelte';

const title = "My Profile — Trail Tools";
const description = "Manage your profile defaults. Your profile drives every tool.";
---

<BaseLayout title={title} description={description}>
  <div class="container tool-container">
    <ToolPage client:load toolId="character" toolName="My Profile" />
  </div>
</BaseLayout>

<style>
  .tool-container {
    padding: 2rem 0 4rem;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }
</style>
