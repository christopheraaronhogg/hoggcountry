---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProtoF from '../components/prototypes/ProtoF_Ranger.svelte';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { YT_SHORTS_FEED_URL, YT_UPLOADS_FEED_URL } from '../lib/config';
import { fetchYouTubeRSS, type YtVideo } from '../lib/youtube';

// Build-time fallback only; ProtoF refreshes from Laravel API at runtime.
const videos = await fetchLatestVideos(18);

async function fetchLatestVideos(limit: number): Promise<YtVideo[]> {
  const [uploads, shorts] = await Promise.all([
    fetchYouTubeRSS(YT_UPLOADS_FEED_URL).catch(() => []),
    fetchYouTubeRSS(YT_SHORTS_FEED_URL).catch(() => []),
  ]);
  const merged = new Map<string, YtVideo>();

  for (const short of shorts) {
    merged.set(short.id, { ...short, kind: 'short' });
  }

  for (const upload of uploads) {
    if (!merged.has(upload.id)) {
      merged.set(upload.id, upload);
    }
  }

  return Array.from(merged.values())
    .sort((a, b) => String(b.published || '').localeCompare(String(a.published || '')))
    .slice(0, limit);
}
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <ProtoF client:visible videos={videos} />
</BaseLayout>
