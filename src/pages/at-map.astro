---
import BaseLayout from "../layouts/BaseLayout.astro";
// Scout's trail map explorer (shared with apps/openclaw-web) replaces the
// legacy AtMap HUD so Astro rollback/archive routes and SvelteKit stay aligned.
import TrailMapExplorer from "../../apps/openclaw-web/src/lib/components/TrailMapExplorer.svelte";

// The map pack API lives on the Forge host; CSP connect-src and the
// endpoint's CORS headers both allow this cross-origin fetch.
const MAP_PACK_ENDPOINT = "https://hoggcountry.on-forge.com/track/map-pack";
---

<BaseLayout
  title="Appalachian Trail Map"
  description="A live Appalachian Trail map with Garmin history, elevation, difficulty, rockiness, water, shelters, roads, and resupply context."
>
  <TrailMapExplorer
    client:only="svelte"
    endpoint={MAP_PACK_ENDPOINT}
    title="AT Map"
    publicRoute
  />
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }

  /* /at-map is the full-screen hub; navigation is provided via the HUD */
  :global(#site-header),
  :global(footer),
  :global(#version-stamp) {
    display: none;
  }

  :global(main#main-content) {
    padding: 0;
  }
</style>
