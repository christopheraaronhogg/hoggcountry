APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_AUTH_CALLBACK_URL=http://localhost:4321/login
FRONTEND_PASSWORD_RESET_URL=http://localhost:4321/reset-password
FRONTEND_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_REGISTRATION_ENABLED=false
SCOUT_LAUNCH_INVITE_EMAIL=
SCOUT_LAUNCH_INVITE_PASSWORD=
SCOUT_LAUNCH_INVITE_NAME=
SCOUT_LAUNCH_INVITE_TRAIL_NAME=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

TRAIL_UPDATES_STORAGE_DISK=r2
TRAIL_UPDATES_SCRATCH_DISK=local
TRAIL_UPDATES_MAX_MEDIA_MB=500

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

SCOUT_WEB_PROXY_ENABLED=false
SCOUT_WEB_PROXY_ORIGIN=http://127.0.0.1:3000

# Web PWA Scripture Ask (app.hoggcountry.com). The iOS app answers on-device with
# Gemma and never uses this. With no key the /api/v1/scripture/answer endpoint
# returns 503 and the PWA shows cited verses only.
OPENAI_API_KEY=
OPENAI_SCRIPTURE_MODEL=gpt-4.1-mini

# Default public Garmin tracker used by trackers:refresh when no saved tracker exists.
HOGGCOUNTRY_DEFAULT_TRACKER_ENABLED=true
HOGGCOUNTRY_GARMIN_SHARE_ID=hoggcountry
HOGGCOUNTRY_DEFAULT_TRACKER_LABEL=HoggCountry
HOGGCOUNTRY_TRACKER_OWNER_EMAIL=hoggcountry-tracker@hoggcountry.local

# Comma-separated allowlist for VideoHogg intake access
VIDEOHOGG_ALLOWED_EMAILS=

# Comma-separated allowlist for VideoHogg YouTube ideas access
VIDEOHOGG_YOUTUBE_IDEA_EMAILS=

# Storage disk for VideoHogg uploads/manifests (`public` or `s3` for R2/S3)
VIDEOHOGG_STORAGE_DISK=public

# YouTube feed defaults used by /api/v1/videos/latest
YOUTUBE_CHANNEL_ID=UCtlUsN3UpR-Vmb-XbgAuNHg
YOUTUBE_PLAYLIST_ID=PLfcu9P1xhBSXb6ZtDe4fmSlfQliywdGoD
