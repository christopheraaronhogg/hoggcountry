# Production build config for the Hogg Country mobile app.
# Vite loads this automatically for `vite build` (production mode), so EVERY
# shipped/sideloaded build — not just the Play release script — is Gemma-only.
#
# Why this matters: without it, builds default to MODEL_POLICY='offline-tools'
# (src/lib/trailState.svelte.ts), which lets Scout silently answer from the
# deterministic offline-template provider when on-device generation fails —
# the "asked a question, it acted offline" bug. Gemma-only forces the on-device
# path and surfaces a real failure instead of masquerading as an offline answer.
#
# Dev (`vite dev`) does NOT load this, so the browser preview still runs without
# a native model. Only VITE_-prefixed (public, non-secret) vars belong here.
VITE_SCOUT_MODEL_POLICY=gemma4-only
