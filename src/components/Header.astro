---
import { LIVE_TRACKING_ENABLED, LIVE_TRACKING_START_DATE, LIVE_TRACKING_URL, WORKSPACE_URL } from '../lib/config';
import { isEnabled } from '../lib/features';

const pathname = Astro.url.pathname;
const isGuide = pathname.startsWith('/guide');
const isVideos = pathname.startsWith('/videos');
const isUpdates = pathname.startsWith('/updates');
const isHome = pathname === '/';
const showVideos = isEnabled('YOUTUBE_RSS');

const now = new Date();
const startDate = new Date(LIVE_TRACKING_START_DATE);
const showTracking = LIVE_TRACKING_ENABLED && now >= startDate;
---

<header class="site-header">
  <nav class="container nav">
    <a href="/" class="brand" aria-label="Hogg Country home">
      <img src="/logo.png" alt="Hogg Country" class="logo" />
    </a>

    <div class="desktop-links">
      <a href="/guide/" class:list={['nav-link', isGuide && 'is-active']}>Dad&apos;s Field Guide</a>
      <a href="/updates/" class:list={['nav-link', isUpdates && 'is-active']}>Trail Updates</a>
      {showVideos && <a href="/videos/" class:list={['nav-link', isVideos && 'is-active']}>Video Dispatches</a>}
      {showTracking && (
        <a href={LIVE_TRACKING_URL} class="nav-link nav-link--track" target="_blank" rel="noopener noreferrer">Track Me</a>
      )}
      <a href={WORKSPACE_URL} class="workspace-link">Open Workspace</a>
    </div>

    <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      Menu
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href="/" class:list={['mobile-link', isHome && 'is-active']}>Home</a>
    <a href="/guide/" class:list={['mobile-link', isGuide && 'is-active']}>Dad&apos;s Field Guide</a>
    <a href="/updates/" class:list={['mobile-link', isUpdates && 'is-active']}>Trail Updates</a>
    {showVideos && <a href="/videos/" class:list={['mobile-link', isVideos && 'is-active']}>Video Dispatches</a>}
    {showTracking && (
      <a href={LIVE_TRACKING_URL} class="mobile-link" target="_blank" rel="noopener noreferrer">Track Me</a>
    )}
    <a href={WORKSPACE_URL} class="mobile-link mobile-link--workspace">Open Workspace</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(247, 242, 232, 0.94);
    border-bottom: 1px solid rgba(48, 65, 54, 0.12);
    backdrop-filter: blur(12px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .logo {
    height: 44px;
    width: auto;
  }

  .desktop-links {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-link,
  .workspace-link,
  .mobile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(48, 65, 54, 0.12);
    background: rgba(255, 255, 255, 0.72);
    color: var(--pine);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
  }

  .nav-link:hover,
  .workspace-link:hover,
  .mobile-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    border-color: rgba(48, 65, 54, 0.24);
  }

  .nav-link.is-active,
  .mobile-link.is-active {
    background: rgba(166, 181, 137, 0.24);
    color: var(--ink);
  }

  .nav-link--track {
    border-color: rgba(185, 28, 28, 0.18);
    color: #9f1239;
  }

  .workspace-link,
  .mobile-link--workspace {
    background: linear-gradient(160deg, rgba(240, 224, 0, 0.88), rgba(249, 243, 188, 0.96));
    color: #1f2937;
    border-color: rgba(217, 119, 6, 0.28);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .menu-toggle {
    min-height: 42px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(48, 65, 54, 0.12);
    background: rgba(255, 255, 255, 0.72);
    color: var(--pine);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .mobile-menu {
    display: grid;
    gap: 0.75rem;
    padding: 0 1rem 1rem;
  }

  @media (min-width: 860px) {
    .desktop-links {
      display: flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      menu.hidden = open;
    });
  })();
</script>
