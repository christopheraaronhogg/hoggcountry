---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShelvedFeature from '../../components/ShelvedFeature.astro';
import { WORKSPACE_URL } from '../../lib/config';
---

<BaseLayout title="Trail Tools Moved | Hogg Country" description="The old multi-tool dashboard has been folded into the personal field manual workspace.">
  <ShelvedFeature
    feature="ROUTE_MULTITOOL_DASHBOARD"
    kicker="Merged"
    heading="Trail tools now live inside the workspace."
    body="The old dashboard is no longer a standalone public surface. The important parts are being folded into Today and Plan so hikers get fewer, calmer screens."
    primary={{ href: `${WORKSPACE_URL}/today`, label: 'Open Today' }}
    secondary={{ href: `${WORKSPACE_URL}/plan`, label: 'Open Plan' }}
  />
</BaseLayout>
