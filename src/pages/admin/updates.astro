---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Trail Updates Admin • Hogg Country</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #253126;
        --pine: #4d594a;
        --terra: #9b5a2e;
        --muted: #657163;
        --paper: #f7f2e8;
        --line: rgba(48, 65, 54, 0.14);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Atkinson Hyperlegible, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(166, 181, 137, 0.2), transparent 32%),
          linear-gradient(180deg, var(--paper), #efe5d4);
        color: var(--ink);
      }

      main {
        width: min(920px, calc(100% - 1.5rem));
        margin: 0 auto;
        padding: 1rem 0 3rem;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
      }

      a { color: var(--pine); font-weight: 800; }
      h1, h2, h3 { margin: 0; line-height: 1.05; }
      h1 { font-size: clamp(2.2rem, 10vw, 4.4rem); max-width: 8ch; }
      p { color: var(--muted); line-height: 1.6; }

      .card {
        border: 1px solid var(--line);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.86);
        box-shadow: 0 22px 50px rgba(60, 44, 25, 0.08);
      }

      .hero, .panel { padding: 1.1rem; }
      .hero { margin-bottom: 1rem; }
      .eyebrow {
        margin: 0 0 0.45rem;
        color: var(--terra);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .hidden { display: none !important; }
      .stack { display: grid; gap: 1rem; }
      .grid { display: grid; gap: 0.85rem; }

      label { display: grid; gap: 0.35rem; color: var(--pine); font-weight: 850; }
      input, textarea, select, button {
        width: 100%;
        min-height: 48px;
        border-radius: 16px;
        border: 1px solid rgba(48, 65, 54, 0.16);
        padding: 0.8rem 0.9rem;
        font: inherit;
      }
      textarea { min-height: 132px; resize: vertical; }
      input, textarea, select { background: rgba(255, 255, 255, 0.9); color: var(--ink); }
      input[type="file"] { padding: 0.7rem; }

      button {
        cursor: pointer;
        border-color: rgba(77, 89, 74, 0.18);
        background: var(--pine);
        color: white;
        font-weight: 900;
      }
      button.secondary { background: white; color: var(--pine); }
      button.danger { background: #9f1239; }
      button:disabled { opacity: 0.6; cursor: wait; }

      .actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
      .actions > * { flex: 1 1 150px; }
      .status { min-height: 1.5rem; color: var(--terra); font-weight: 800; }
      .hint { color: var(--muted); font-weight: 700; line-height: 1.4; }

      .upload-field { gap: 0.55rem; }
      .upload-dropzone {
        display: grid;
        gap: 0.35rem;
        padding: 1rem;
        border: 2px dashed rgba(77, 89, 74, 0.26);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.64);
      }
      .upload-dropzone strong { color: var(--ink); }
      .upload-dropzone input { margin-top: 0.35rem; background: white; }
      .file-summary {
        display: grid;
        grid-template-columns: 76px 1fr;
        gap: 0.75rem;
        align-items: center;
        padding: 0.75rem;
        border: 1px solid rgba(77, 89, 74, 0.16);
        border-radius: 20px;
        background: rgba(77, 89, 74, 0.07);
      }
      .file-summary.error { border-color: rgba(159, 18, 57, 0.35); background: rgba(159, 18, 57, 0.08); }
      .file-summary-body { display: grid; gap: 0.3rem; min-width: 0; }
      .file-summary strong { overflow-wrap: anywhere; color: var(--ink); }
      .file-summary small { color: var(--muted); font-weight: 800; }
      .media-preview {
        width: 76px;
        height: 76px;
        border-radius: 16px;
        overflow: hidden;
        background: #111827;
      }
      .media-preview img, .media-preview video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .file-summary-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
      .file-summary-actions button { min-height: 40px; padding: 0.55rem 0.75rem; }
      .upload-progress {
        display: grid;
        gap: 0.35rem;
        padding: 0.8rem;
        border-radius: 18px;
        background: rgba(155, 90, 46, 0.08);
      }
      .progress-meta { display: flex; justify-content: space-between; gap: 0.75rem; color: var(--terra); font-size: 0.84rem; font-weight: 900; }
      progress { width: 100%; height: 14px; accent-color: var(--terra); }

      .updates-list { display: grid; gap: 0.8rem; }
      .update-row {
        display: grid;
        gap: 0.75rem;
        padding: 0.9rem;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.78);
      }
      .update-row img, .update-row video {
        width: 100%;
        max-height: 260px;
        object-fit: cover;
        border-radius: 18px;
        background: #111827;
      }
      .row-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        color: var(--terra);
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .row-body { white-space: pre-wrap; margin: 0.45rem 0 0; }

      @media (min-width: 720px) {
        main { padding-top: 1.5rem; }
        .hero, .panel { padding: 1.4rem; }
        .grid.two { grid-template-columns: 1fr 1fr; }
        .update-row { grid-template-columns: 180px 1fr; align-items: start; }
        .update-row .no-media { display: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="topbar">
        <a href="/">← Site</a>
        <a href="/updates/">View updates</a>
      </div>

      <section class="hero card">
        <p class="eyebrow">Admin</p>
        <h1>Trail updates.</h1>
        <p>Post quick photos, videos, and text notes from mobile. Large media uploads in safe chunks so bad trail signal has a better chance.</p>
      </section>

      <section id="login-panel" class="panel card stack">
        <div>
          <h2>Enter passcode</h2>
          <p>Use the shared Hogg Country admin passcode.</p>
        </div>
        <form id="login-form" class="stack">
          <label>
            Passcode
            <input name="passcode" type="password" inputmode="numeric" autocomplete="current-password" required />
          </label>
          <button type="submit">Unlock admin</button>
          <div class="status" id="login-status" role="status"></div>
        </form>
      </section>

      <section id="admin-panel" class="stack hidden">
        <form id="update-form" class="panel card stack">
          <div>
            <p class="eyebrow">New post</p>
            <h2>Drop in today’s update.</h2>
          </div>

          <label class="upload-field">
            Photo or video
            <span class="upload-dropzone" id="upload-dropzone">
              <strong id="upload-picker-title">Tap to choose a photo or video</strong>
              <small id="media-limit-hint" class="hint">Temporary max: 100 MB per file. Photos and short videos are stored on Hogg Country for now. Keep this tab open while uploading.</small>
              <input id="media-input" name="media" type="file" accept="image/*,video/*" />
            </span>
          </label>

          <div id="file-summary" class="file-summary hidden" aria-live="polite">
            <div id="file-preview" class="media-preview" aria-hidden="true"></div>
            <div class="file-summary-body">
              <strong id="file-name">No file selected</strong>
              <small id="file-meta"></small>
              <div class="file-summary-actions">
                <button type="button" class="secondary" id="clear-media-button">Remove file</button>
              </div>
            </div>
          </div>

          <div id="upload-progress-wrap" class="upload-progress hidden" aria-live="polite" aria-hidden="true">
            <div class="progress-meta">
              <span id="upload-phase">Upload ready</span>
              <span id="upload-percent">0%</span>
            </div>
            <progress id="upload-progress" max="100" value="0"></progress>
          </div>

          <label>
            Text blip
            <textarea name="body" placeholder="What happened today?"></textarea>
          </label>

          <div class="grid two">
            <label>
              Title
              <input name="title" placeholder="Day 42 — Big climb" maxlength="120" />
            </label>
            <label>
              Location
              <input name="location" placeholder="Damascus, VA" maxlength="120" />
            </label>
          </div>

          <div class="grid two">
            <label>
              Trail mile
              <input name="trailMile" placeholder="470.2" maxlength="40" />
            </label>
            <label>
              Publish status
              <select name="status">
                <option value="published">Publish now</option>
                <option value="draft">Save draft</option>
              </select>
            </label>
          </div>

          <div class="actions">
            <button type="submit" id="post-button">Post update</button>
            <button type="button" class="secondary" id="refresh-button">Refresh list</button>
            <button type="button" class="secondary" id="logout-button">Log out</button>
          </div>
          <div class="status" id="form-status" role="status"></div>
        </form>

        <section class="panel card stack">
          <div>
            <p class="eyebrow">Recent</p>
            <h2>Posted updates</h2>
          </div>
          <div id="updates-list" class="updates-list"></div>
        </section>
      </section>
    </main>

    <script>
      const loginPanel = document.getElementById('login-panel');
      const adminPanel = document.getElementById('admin-panel');
      const loginForm = document.getElementById('login-form');
      const updateForm = document.getElementById('update-form');
      const loginStatus = document.getElementById('login-status');
      const formStatus = document.getElementById('form-status');
      const updatesList = document.getElementById('updates-list');
      const refreshButton = document.getElementById('refresh-button');
      const logoutButton = document.getElementById('logout-button');
      const mediaLimitHint = document.getElementById('media-limit-hint');
      const mediaInput = document.getElementById('media-input');
      const uploadDropzone = document.getElementById('upload-dropzone');
      const fileSummary = document.getElementById('file-summary');
      const filePreview = document.getElementById('file-preview');
      const fileName = document.getElementById('file-name');
      const fileMeta = document.getElementById('file-meta');
      const clearMediaButton = document.getElementById('clear-media-button');
      const uploadProgressWrap = document.getElementById('upload-progress-wrap');
      const uploadProgress = document.getElementById('upload-progress');
      const uploadPhase = document.getElementById('upload-phase');
      const uploadPercent = document.getElementById('upload-percent');
      const postButton = document.getElementById('post-button');

      const API_ORIGIN = ['localhost', '127.0.0.1'].includes(location.hostname)
        ? 'http://127.0.0.1:8000'
        : 'https://hoggcountry.on-forge.com';
      const API_BASE = `${API_ORIGIN}/api/v1/trail-updates`;
      const SESSION_KEY = 'hcTrailUpdatesAdminSession';
      let adminSession = loadSession();
      let maxMediaMb = 100;
      let uploadInFlight = false;
      let previewUrl = null;

      const escapeHtml = (value) => String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const formatDate = (value) => {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return 'Unposted';
        return date.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      };

      const formatBytes = (bytes) => {
        if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB'];
        let value = bytes;
        let unit = 0;
        while (value >= 1024 && unit < units.length - 1) {
          value /= 1024;
          unit += 1;
        }
        return `${value >= 10 || unit === 0 ? value.toFixed(0) : value.toFixed(1)} ${units[unit]}`;
      };

      function updateMediaLimitHint() {
        mediaLimitHint.textContent = `Temporary max: ${maxMediaMb} MB per file. Photos and short videos are stored on Hogg Country for now. Keep this tab open while uploading.`;
      }

      function fileLimitBytes() {
        return maxMediaMb * 1024 * 1024;
      }

      function inferredContentType(file) {
        const explicit = String(file?.type || '').toLowerCase();
        if (explicit && explicit !== 'application/octet-stream') {
          if (explicit === 'image/jpg') return 'image/jpeg';
          if (explicit === 'image/x-heic' || explicit === 'image/heic-sequence') return 'image/heic';
          if (explicit === 'image/x-heif' || explicit === 'image/heif-sequence') return 'image/heif';
          if (explicit === 'video/mov' || explicit === 'video/x-m4v') return 'video/quicktime';
          return explicit;
        }

        const extension = String(file?.name || '').split('.').pop()?.toLowerCase() || '';
        const byExtension = {
          jpg: 'image/jpeg',
          jpeg: 'image/jpeg',
          png: 'image/png',
          webp: 'image/webp',
          gif: 'image/gif',
          heic: 'image/heic',
          heif: 'image/heif',
          mp4: 'video/mp4',
          mov: 'video/quicktime',
          qt: 'video/quicktime',
          webm: 'video/webm',
        };

        return byExtension[extension] || explicit || 'application/octet-stream';
      }

      function describeFileType(file) {
        const type = inferredContentType(file);
        if (type.startsWith('image/')) return type.includes('hei') ? 'iPhone photo' : 'photo';
        if (type.startsWith('video/')) return 'video';
        return type || 'media file';
      }

      function setUploadProgress(percent = 0, label = 'Upload ready', visible = true) {
        const safePercent = Math.max(0, Math.min(100, Math.round(percent)));
        uploadProgressWrap.classList.toggle('hidden', !visible);
        uploadProgressWrap.setAttribute('aria-hidden', visible ? 'false' : 'true');
        uploadProgress.value = safePercent;
        uploadPhase.textContent = label;
        uploadPercent.textContent = `${safePercent}%`;
      }

      function resetUploadProgress() {
        setUploadProgress(0, 'Upload ready', false);
      }

      function clearPreviewUrl() {
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = null;
      }

      function renderFilePreview(file) {
        clearPreviewUrl();
        filePreview.innerHTML = '';
        if (!file) return;

        previewUrl = URL.createObjectURL(file);
        const type = inferredContentType(file);
        if (type.startsWith('image/')) {
          const img = document.createElement('img');
          img.src = previewUrl;
          img.alt = '';
          filePreview.append(img);
          return;
        }

        if (type.startsWith('video/')) {
          const video = document.createElement('video');
          video.src = previewUrl;
          video.muted = true;
          video.playsInline = true;
          video.preload = 'metadata';
          filePreview.append(video);
          return;
        }

        filePreview.textContent = 'File';
      }

      function updateFileSummary() {
        const file = mediaInput.files?.[0];
        resetUploadProgress();
        if (!file) {
          fileSummary.classList.add('hidden');
          fileSummary.classList.remove('error');
          fileName.textContent = 'No file selected';
          fileMeta.textContent = '';
          clearPreviewUrl();
          filePreview.innerHTML = '';
          return;
        }

        const overLimit = file.size > fileLimitBytes();
        fileSummary.classList.remove('hidden');
        fileSummary.classList.toggle('error', overLimit);
        fileName.textContent = file.name || 'Selected media';
        fileMeta.textContent = `${describeFileType(file)} • ${formatBytes(file.size)} • max ${maxMediaMb} MB`;
        renderFilePreview(file);

        if (overLimit) {
          const overBy = file.size - fileLimitBytes();
          formStatus.textContent = `That file is too large by ${formatBytes(overBy)}. Max is ${maxMediaMb} MB for now.`;
        } else {
          formStatus.textContent = `Ready to upload ${formatBytes(file.size)}. Keep this tab open after tapping Post update.`;
        }
      }

      function clearMediaSelection() {
        mediaInput.value = '';
        updateFileSummary();
        formStatus.textContent = '';
      }

      function loadSession() {
        try {
          const parsed = JSON.parse(localStorage.getItem(SESSION_KEY) || 'null');
          if (!parsed?.token || !parsed?.expiresAt || new Date(parsed.expiresAt).getTime() <= Date.now()) return null;
          return parsed;
        } catch {
          return null;
        }
      }

      function saveSession(session) {
        adminSession = session;
        if (session) localStorage.setItem(SESSION_KEY, JSON.stringify(session));
        else localStorage.removeItem(SESSION_KEY);
      }

      const setAuthed = (authed) => {
        loginPanel.classList.toggle('hidden', authed);
        adminPanel.classList.toggle('hidden', !authed);
        if (authed) loadUpdates();
      };

      async function apiRequest(path = '', options = {}) {
        const { auth = true, headers: providedHeaders, ...fetchOptions } = options;
        const headers = new Headers(providedHeaders || {});
        if (auth && adminSession?.token) headers.set('Authorization', `Bearer ${adminSession.token}`);

        const res = await fetch(`${API_BASE}${path}`, {
          ...fetchOptions,
          headers,
        });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok) {
          const message = payload?.error?.message || payload?.message || `Request failed (${res.status}).`;
          throw new Error(message);
        }
        return payload?.data ?? payload;
      }

      const originalMediaUrl = (update) => update.mediaUrl || update.previewUrl || update.thumbnailUrl || '';
      const thumbnailMediaUrl = (update) => update.thumbnailUrl || update.previewUrl || originalMediaUrl(update);

      const mediaHtml = (update) => {
        const originalUrl = originalMediaUrl(update);
        if (!originalUrl) return '<div class="no-media"></div>';
        const thumbnailUrl = thumbnailMediaUrl(update);
        if (String(update.mediaType || '').startsWith('video/')) {
          if (thumbnailUrl && thumbnailUrl !== originalUrl) {
            return `<img src="${escapeHtml(thumbnailUrl)}" alt="${escapeHtml(update.title || update.body || 'Trail update video')}" />`;
          }
          return `<video src="${escapeHtml(originalUrl)}" controls playsinline preload="metadata"></video>`;
        }
        return `<img src="${escapeHtml(thumbnailUrl)}" alt="${escapeHtml(update.title || update.body || 'Trail update')}" />`;
      };

      const rowHtml = (update) => {
        const bits = [update.status, formatDate(update.publishedAt || update.createdAt)];
        if (update.location) bits.push(update.location);
        if (update.trailMile) bits.push(`Mile ${update.trailMile}`);
        if (update.mediaSize) bits.push(formatBytes(Number(update.mediaSize)));
        return `
          <article class="update-row">
            ${mediaHtml(update)}
            <div>
              <div class="row-meta">${bits.map((bit) => `<span>${escapeHtml(bit)}</span>`).join('<span>•</span>')}</div>
              <h3>${escapeHtml(update.title || 'Trail update')}</h3>
              ${update.body ? `<p class="row-body">${escapeHtml(update.body)}</p>` : ''}
              <div class="actions" style="margin-top:.75rem">
                <button type="button" class="secondary" data-copy="${escapeHtml(update.id)}">Copy link</button>
                <button type="button" class="danger" data-delete="${escapeHtml(update.id)}">Delete</button>
              </div>
            </div>
          </article>
        `;
      };

      async function loadUpdates() {
        updatesList.textContent = 'Loading…';
        try {
          const data = await apiRequest('?admin=1&limit=50');
          if (data.max_media_mb) maxMediaMb = Number(data.max_media_mb) || maxMediaMb;
          updateMediaLimitHint();
          const updates = Array.isArray(data.updates) ? data.updates : [];
          updatesList.innerHTML = updates.length ? updates.map(rowHtml).join('') : '<p>No updates yet.</p>';
        } catch (error) {
          updatesList.textContent = error.message || 'Could not load updates.';
          if (String(error.message || '').toLowerCase().includes('admin')) {
            saveSession(null);
            setAuthed(false);
          }
        }
      }

      async function uploadChunk(uploadId, chunkIndex, chunk, chunkCount, uploadedBytes, totalBytes) {
        let lastError;
        for (let attempt = 1; attempt <= 3; attempt += 1) {
          try {
            if (attempt > 1) {
              setUploadProgress((uploadedBytes / totalBytes) * 100, `Signal hiccup — retrying chunk ${chunkIndex + 1} of ${chunkCount}`);
            }
            return await apiRequest(`/media-uploads/${encodeURIComponent(uploadId)}/chunks/${chunkIndex}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/octet-stream' },
              body: chunk,
            });
          } catch (error) {
            lastError = error;
            await new Promise((resolve) => setTimeout(resolve, attempt * 900));
          }
        }
        throw lastError || new Error('Could not upload media chunk.');
      }

      updateMediaLimitHint();
      updateFileSummary();

      async function uploadMedia(file) {
        if (!file || file.size <= 0) return null;
        if (file.size > fileLimitBytes()) {
          throw new Error(`That file is ${formatBytes(file.size)}. Current temporary limit is ${maxMediaMb} MB until R2 is wired.`);
        }

        uploadInFlight = true;
        setUploadProgress(1, `Starting ${formatBytes(file.size)} upload…`);
        const started = await apiRequest('/media-uploads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            filename: file.name || 'trail-upload',
            contentType: inferredContentType(file),
            size: file.size,
          }),
        });

        const upload = started.upload;
        const chunkSize = Number(upload.chunkSize || 786432);
        const chunkCount = Number(upload.chunkCount || Math.ceil(file.size / chunkSize));

        for (let index = 0; index < chunkCount; index += 1) {
          const start = index * chunkSize;
          const end = Math.min(file.size, start + chunkSize);
          const pctBefore = (start / file.size) * 100;
          setUploadProgress(pctBefore, `Uploading chunk ${index + 1} of ${chunkCount}`);
          await uploadChunk(upload.uploadId, index, file.slice(start, end), chunkCount, start, file.size);
          const pct = Math.max(1, Math.round((end / file.size) * 100));
          setUploadProgress(pct, `Uploading ${formatBytes(end)} of ${formatBytes(file.size)}`);
        }

        setUploadProgress(100, 'Finalizing media…');
        const completed = await apiRequest(`/media-uploads/${encodeURIComponent(upload.uploadId)}/complete`, {
          method: 'POST',
        });

        setUploadProgress(100, 'Media ready — posting update…');
        return completed.media;
      }

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        loginStatus.textContent = 'Checking…';
        try {
          const passcode = new FormData(loginForm).get('passcode');
          const data = await apiRequest('/admin/session', {
            auth: false,
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ passcode }),
          });
          saveSession({ token: data.token, expiresAt: data.expires_at });
          loginForm.reset();
          loginStatus.textContent = '';
          setAuthed(true);
        } catch {
          loginStatus.textContent = 'Wrong passcode.';
        }
      });

      updateForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        formStatus.textContent = 'Preparing update…';
        postButton.disabled = true;
        postButton.textContent = 'Uploading…';
        try {
          const formData = new FormData(updateForm);
          const file = formData.get('media');
          formData.delete('media');

          if (file instanceof File && file.size > 0) {
            const media = await uploadMedia(file);
            if (media?.uploadId) formData.set('mediaUploadId', media.uploadId);
          } else {
            resetUploadProgress();
          }

          formStatus.textContent = 'Posting update…';
          await apiRequest('', {
            method: 'POST',
            body: formData,
          });
          updateForm.reset();
          clearMediaSelection();
          setUploadProgress(100, 'Posted');
          formStatus.textContent = 'Posted. It should show on the public updates page shortly.';
          await loadUpdates();
          setTimeout(resetUploadProgress, 1800);
        } catch (error) {
          formStatus.textContent = error.message || 'Could not post update.';
        } finally {
          uploadInFlight = false;
          postButton.disabled = false;
          postButton.textContent = 'Post update';
        }
      });

      updatesList.addEventListener('click', async (event) => {
        const target = event.target;
        const copy = target?.closest?.('[data-copy]');
        const del = target?.closest?.('[data-delete]');
        if (copy) {
          await navigator.clipboard.writeText(`${location.origin}/updates/`);
          formStatus.textContent = 'Public updates link copied.';
        }
        if (del) {
          if (!confirm('Delete this trail update?')) return;
          const id = del.getAttribute('data-delete');
          try {
            await apiRequest(`/${encodeURIComponent(id)}`, { method: 'DELETE' });
            formStatus.textContent = 'Deleted.';
          } catch (error) {
            formStatus.textContent = error.message || 'Could not delete update.';
          }
          await loadUpdates();
        }
      });

      mediaInput.addEventListener('change', updateFileSummary);
      clearMediaButton.addEventListener('click', clearMediaSelection);
      uploadDropzone.addEventListener('dragover', (event) => {
        event.preventDefault();
        uploadDropzone.style.borderColor = 'rgba(155, 90, 46, 0.55)';
      });
      uploadDropzone.addEventListener('dragleave', () => {
        uploadDropzone.style.borderColor = '';
      });
      uploadDropzone.addEventListener('drop', (event) => {
        event.preventDefault();
        uploadDropzone.style.borderColor = '';
        const file = event.dataTransfer?.files?.[0];
        if (!file) return;
        const transfer = new DataTransfer();
        transfer.items.add(file);
        mediaInput.files = transfer.files;
        updateFileSummary();
      });
      window.addEventListener('beforeunload', (event) => {
        if (!uploadInFlight) return;
        event.preventDefault();
        event.returnValue = '';
      });

      refreshButton.addEventListener('click', loadUpdates);
      logoutButton.addEventListener('click', () => {
        saveSession(null);
        setAuthed(false);
      });

      if (adminSession) {
        apiRequest('/admin/session')
          .then((data) => setAuthed(Boolean(data.authenticated)))
          .catch(() => {
            saveSession(null);
            setAuthed(false);
          });
      } else {
        setAuthed(false);
      }
    </script>
  </body>
</html>
