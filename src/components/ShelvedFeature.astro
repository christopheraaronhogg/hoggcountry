---
import { getFlag, type FeatureKey } from '../lib/features';

interface ActionLink {
  href: string;
  label: string;
}

interface Props {
  feature: FeatureKey;
  kicker?: string;
  heading: string;
  body: string;
  primary: ActionLink;
  secondary?: ActionLink;
}

const {
  feature,
  kicker = 'Shelved',
  heading,
  body,
  primary,
  secondary,
} = Astro.props;

const flag = getFlag(feature);
---

<section class="shelf">
  <div class="panel">
    <p class="kicker">{kicker}</p>
    <h1>{heading}</h1>
    <p class="body">{body}</p>

    <div class="meta">
      <span class={`badge badge-${flag.status}`}>{flag.status}</span>
      <p>{flag.reason}</p>
    </div>

    <div class="actions">
      <a class="primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .shelf {
    padding: 4rem 1rem 5rem;
  }

  .panel {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem;
    border-radius: 28px;
    border: 1px solid rgba(48, 65, 54, 0.12);
    background:
      radial-gradient(circle at top left, rgba(166, 181, 137, 0.12), transparent 30%),
      rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.08);
  }

  .kicker {
    margin: 0 0 0.4rem;
    color: #b45309;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #1f2937;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 0.96;
  }

  .body {
    margin: 0.9rem 0 0;
    max-width: 58ch;
    color: #5d675c;
    line-height: 1.75;
  }

  .meta {
    margin-top: 1.2rem;
    padding: 1rem;
    border-radius: 20px;
    background: rgba(245, 242, 232, 0.82);
    border: 1px solid rgba(48, 65, 54, 0.08);
  }

  .meta p {
    margin: 0.6rem 0 0;
    color: #5d675c;
    line-height: 1.6;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .badge-live { color: #2d5a3d; background: #e4f0e6; }
  .badge-experimental { color: #6b4e1a; background: #f5ecd4; }
  .badge-merged { color: #3a4a6b; background: #e2e8f3; }
  .badge-deferred { color: #4a4a4a; background: #ededed; }
  .badge-archived { color: #6b3a3a; background: #f1e0e0; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
  }

  .primary {
    background: #304136;
    color: white;
  }

  .secondary {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(48, 65, 54, 0.14);
    color: #304136;
  }
</style>
