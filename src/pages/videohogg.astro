    top: -6px;
    bottom: -6px;
    width: 3px;
    border-radius: 999px;
    background: #facc15;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.45);
  }

  .vh-remotion-segment.is-drop-before::before {
    left: -2px;
  }

  .vh-remotion-segment.is-drop-after::after {
    right: -2px;
  }

