# Production build config for the Hogg Country mobile app.
# Vite loads this automatically for `vite build` (production mode), so EVERY
# shipped/sideloaded build — not just the Play release script — is Gemma-only.
#
# The deterministic template answer lane was removed. Keep this explicit so a
# future environment edit cannot accidentally reintroduce non-model Scout prose.
# Only VITE_- and PUBLIC_-prefixed (public, non-secret) vars belong here — both
# are exposed to the client build (see envPrefix in vite.config.ts).
VITE_SCOUT_MODEL_POLICY=gemma4-only

# Live tramily/family location + Trail Pulse / water reports — the self-hosted
# SpacetimeDB instance (docs/runbooks/spacetimedb-self-host.md). Public, non-secret:
# a TLS host URL + the database name. With these set, the app connects on launch.
PUBLIC_SPACETIMEDB_HOST=https://stdb.hoggcountry.com
PUBLIC_SPACETIMEDB_DB_NAME=hoggcountry

# Web Push subscriptions use this public VAPID key. The matching private key
# stays server-side in Forge as VAPID_PRIVATE_KEY.
PUBLIC_VAPID_PUBLIC_KEY=BPZWjEDDOFsIfxvW_m6vYIMprd479GxHfRauNVbmlUd_XDkbkNM58pAnr3jSpurrEGTTWjG4wrFUhL8lfEeb44c
