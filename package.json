{
  "name": "hogg-country",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:public",
    "dev:public": "npm run dev -w @hoggcountry/public",
    "dev:workspace": "npm run dev -w @hoggcountry/workspace",
    "dev:openclaw": "npm run dev -w @hoggcountry/openclaw-web",
    "dev:all": "npx concurrently -k -n public,workspace,openclaw \"npm run dev:public\" \"npm run dev:workspace\" \"npm run dev:openclaw\"",
    "prebuild": "node scripts/parse-master-guide.js && node scripts/generate-search-index.js && node scripts/build-public-corpus.js && node scripts/build-guide-context.js && node scripts/build-kjv-context.js && node scripts/build-proverbs-json.js",
    "build": "npm run build:public && npm run build:workspace && npm run build:openclaw",
    "build:public": "npm run build -w @hoggcountry/public",
    "build:workspace": "npm run build -w @hoggcountry/workspace",
    "build:openclaw": "npm run build -w @hoggcountry/openclaw-web",
    "build:openclaw:forge": "npm run prebuild && OPENCLAW_WEB_ADAPTER=node npm run build -w @hoggcountry/openclaw-web",
    "build:game": "cd trailhogg/trailhogg && npm install && cd shared && npm install && npm run build && cd ../client && npm install && npm run build",
    "postbuild": "node scripts/generate-asset-manifest.js",
    "build:pdf": "node scripts/generate-pdf.js",
    "build:all": "npm run build && node scripts/generate-pdf.js",
    "update-guide": "node scripts/parse-master-guide.js",
    "test": "node --experimental-strip-types --experimental-transform-types --test scripts/parse-master-guide.test.js scripts/kjv-pce.test.mjs scripts/scout-skills.test.mjs scripts/scout-reliability-arena.test.mjs scripts/scout-runtime-tools.test.mjs scripts/scout-beta-logins.test.mjs",
    "test:guide": "node --test scripts/parse-master-guide.test.js",
    "dogfood:manual": "node scripts/dogfood-field-manual.mjs",
    "eval:scout-grounding": "node --experimental-strip-types --experimental-transform-types scripts/eval-scout-grounding.mjs",
    "eval:scout-sources": "node --experimental-strip-types --experimental-transform-types scripts/eval-scout-sources.mjs",
    "eval:scout-reliability": "node --experimental-strip-types --experimental-transform-types scripts/eval-scout-reliability.mjs",
    "eval:scout-holdout": "node --experimental-strip-types --experimental-transform-types scripts/eval-scout-reliability.mjs --scenario-file data/scout-reliability/holdout-scenarios.json --suite-name holdout-generalization-2026-05-07",
    "review:scout-model": "node scripts/review-scout-model-responses.mjs",
    "check:mileage": "node scripts/check-mileage-consistency.js",
    "check:water": "node scripts/validate-water-sources.js",
    "check:hydro": "node scripts/validate-hydro-crossings.js",
    "import:awol-water": "node scripts/import-awol-water-sources.js",
    "ref:awol-water": "node scripts/generate-awol-water-reference.js",
    "awol:pdf-to-text": "node scripts/awol-pdf-to-text.js",
    "awol:raw-to-csv": "node scripts/awol-water-raw-to-csv.js",
    "awol:extract-water": "node scripts/extract-awol-water-sources.js",
    "awol:build-water": "npm run awol:pdf-to-text && npm run awol:extract-water && npm run import:awol-water && npm run ref:awol-water",
    "build:hydro": "node scripts/build-at-hydro-crossings.js",
    "compare:water": "node scripts/compare-water-sources.js",
    "auth:user": "node scripts/generate-auth-user.mjs",
    "backend:install": "sh -c 'cd backend && composer install && (test -f .env || cp .env.example .env) && (grep -q \"^APP_KEY=base64:\" .env || php artisan key:generate) && php artisan migrate'",
    "backend:dev": "cd backend && composer run dev",
    "backend:frontend:dev": "cd backend && npm run dev",
    "backend:frontend:build": "cd backend && npm run build",
    "backend:migrate": "cd backend && php artisan migrate",
    "backend:test": "cd backend && php artisan test",
    "monorepo:dev": "npx concurrently -k -n web,api \"npm run dev\" \"npm run backend:dev\"",
    "monorepo:check": "npm run build && npm run backend:frontend:build && npm run backend:test",
    "verify:forge": "node scripts/verify-forge-deploy.mjs",
    "trail-assistant:verify-urls": "node scripts/trail-assistant-url-matrix.mjs",
    "trail-assistant:chatgpt-proof": "node scripts/openclaw-codex-proof.mjs",
    "trail-assistant:chatgpt-bridge": "node scripts/openclaw-codex-local-bridge.mjs",
    "trail-assistant:blocker-email": "python3 scripts/trail_assistant_blocker_email_helper.py",
    "trail-assistant:runlog-autoupdate": "python3 scripts/trail_assistant_runlog_autoupdater.py",
    "trail-assistant:queue-review": "python3 scripts/trail_assistant_queue_review_helper.py",
    "preview": "npm run preview:public",
    "preview:public": "npm run preview -w @hoggcountry/public",
    "preview:workspace": "npm run preview -w @hoggcountry/workspace",
    "preview:openclaw": "npm run preview -w @hoggcountry/openclaw-web",
    "start:openclaw:forge": "cd apps/openclaw-web && HOST=${HOST:-127.0.0.1} PORT=${PORT:-3000} node build",
    "forge:openclaw:pm2": "pm2 startOrReload apps/openclaw-web/ecosystem.config.cjs --update-env",
    "forge:openclaw:pm2:status": "pm2 show hoggcountry-openclaw",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.2",
    "@astrojs/svelte": "^7.1.0",
    "@netlify/blobs": "^10.7.4",
    "@remotion/player": "^4.0.420",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.8",
    "codehogg": "^3.0.0",
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.1",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "marked": "^17.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.420",
    "sharp": "^0.34.2",
    "svelte": "^5.55.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.57.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "opensrc": "^0.6.0",
    "puppeteer": "^24.34.0",
    "spacetimedb": "^2.1.0"
  }
}
