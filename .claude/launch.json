{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scout-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@hoggcountry/scout-web", "--", "--port", "5188", "--strictPort"],
      "port": 5188,
      "autoPort": false
    },
    {
      "name": "scout-mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "dev", "--", "--port", "5199", "--strictPort"],
      "port": 5199,
      "autoPort": false
    },
    {
      "name": "scout-mobile-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "preview", "--", "--port", "5201", "--strictPort", "--host"],
      "port": 5201,
      "autoPort": false
    },
    {
      "name": "bakeoff-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "docs/design", "-p", "5210", "-c-1"],
      "port": 5210,
      "autoPort": false
    }
  ]
}
